# Operating system and editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment and secret material (never commit plaintext credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.kubeconfig
*.vault-password
secrets/**/*.dec.yaml
secrets/**/*.plain.yaml

# Ansible local state, caches, and generated artifacts
*.retry
.ansible/
ansible/collections/ansible_collections/
agents/ansible/artifacts/
agents/ansible/private_data_dir/

# Helm, Kubernetes, and temporary render output
charts/**/charts/
charts/**/tmpcharts/
*.tgz
rendered/
tmp/
.tmp/
local/
# 재현 가능한 검증 스크립트는 추적하고, 런타임 상태만 local/에 둔다.
!scripts/local/
!scripts/local/**

# Test, coverage, and logs
.pytest_cache/
.molecule/
coverage/
htmlcov/
*.log
