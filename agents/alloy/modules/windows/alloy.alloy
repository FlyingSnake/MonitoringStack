declare "pipeline" {
  argument "hostname" {}

  loki.write "default" {
    endpoint {
      url = sys.env("LOKI_URL")
      basic_auth {
        username = sys.env("INGEST_USERNAME")
        password = sys.env("INGEST_PASSWORD")
      }
      tls_config {
        ca_file   = sys.env("ALLOY_TLS_CA_FILE")
        cert_file = sys.env("ALLOY_TLS_CERT_FILE")
        key_file  = sys.env("ALLOY_TLS_KEY_FILE")
      }
    }
    external_labels = {
      environment = sys.env("MONITORING_ENVIRONMENT"),
      host        = argument.hostname.value,
      source      = "windows",
    }
  }

  loki.source.windowsevent "application" {
    eventlog_name = "Application"
    forward_to    = [loki.write.default.receiver]
    labels = { job = "windows-eventlog" }
  }

  otelcol.receiver.otlp "default" {
    grpc {}
    http {}
    output {
      traces = [otelcol.exporter.otlphttp.tempo.input]
    }
  }

  otelcol.auth.basic "ingest" {
    client_auth {
      username = sys.env("INGEST_USERNAME")
      password = sys.env("INGEST_PASSWORD")
    }
  }

  otelcol.exporter.otlphttp "tempo" {
    client {
      endpoint = sys.env("TEMPO_OTLP_HTTP_ENDPOINT")
      auth     = otelcol.auth.basic.ingest.handler
      tls {
        ca_file   = sys.env("ALLOY_TLS_CA_FILE")
        cert_file = sys.env("ALLOY_TLS_CERT_FILE")
        key_file  = sys.env("ALLOY_TLS_KEY_FILE")
      }
    }
  }
}
